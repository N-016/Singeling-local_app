{
  "name": "snglngapp",
  "productName": "Singeling App",
  "version": "1.3.0-beta.2",
  "description": "",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test-rules.js && node scripts/test-telemetry.js && node scripts/test-server.js",
    "check:themes": "node scripts/check-themes.js",
    "previews": "electron scripts/theme-previews.js",
    "prebuild": "npm test && node scripts/check-themes.js",
    "build": "electron-builder"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.singeling.app",
    "productName": "Singeling App",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist{,/**/*}",
      "!dist-*{,/**/*}",
      "!.claude{,/**/*}",
      "!scripts{,/**/*}",
      "!supabase{,/**/*}",
      "!.github{,/**/*}"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "Singeling-App-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "shortcutName": "Singeling App"
    },
    "publish": {
      "provider": "github",
      "owner": "N-016",
      "repo": "Singeling-local_app",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
